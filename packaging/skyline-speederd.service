[Unit]
Description=Skyline Speeder experimental TCP congestion-control daemon
Documentation=https://github.com/CYBERVERSE-Research/skyline-speeder/blob/main/DEPLOY.md
After=network.target
ConditionPathExists=/etc/skyline-speeder/speeder.toml

[Service]
Type=simple
ExecStartPre=/bin/mkdir -p /sys/fs/bpf/skyline-speeder /sys/fs/cgroup/skyline-speeder
ExecStart=/usr/local/sbin/skyline-speederd --config /etc/skyline-speeder/speeder.toml
Restart=on-failure
RestartSec=2
NoNewPrivileges=false
ProtectSystem=strict
RuntimeDirectory=skyline-speeder
# /var/lib/skyline-speeder: where the daemon records an error it stops on, for
# the next ssctl on a terminal to offer as an error report (DAEMON_REPORTS_DIR
# in skyline-common). Unlike RuntimeDirectory= it outlives a failed start --
# the very failure worth a report -- and a reboot.
StateDirectory=skyline-speeder
StateDirectoryMode=0700
ReadWritePaths=-/sys/fs/bpf/skyline-speeder -/sys/fs/cgroup/skyline-speeder
PrivateTmp=true

[Install]
WantedBy=multi-user.target

