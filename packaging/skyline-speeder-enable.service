[Unit]
Description=Attach Skyline Speeder skyline_cc and select it, with the fq qdisc, as the system TCP congestion control
Documentation=https://github.com/CYBERVERSE-Research/skyline-speeder/blob/main/docs/01-deployment-guide.md
After=skyline-speederd.service
Requires=skyline-speederd.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=120
ExecStart=/opt/skyline-speeder/infra/boot-enable.sh
ExecStop=/opt/skyline-speeder/infra/boot-disable.sh

[Install]
WantedBy=multi-user.target
